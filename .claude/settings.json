{
  "permissions": {
    "allow": [
      "Bash(node build.js)",
      "Bash(node *.js)"
    ],
    "deny": [
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node build.js"
          }
        ]
      }
    ]
  }
}
